#!/bin/bash
#
# homicron: workstation-side runner.
#
#   bin/homicron apply <name>    rsync host/ to the box, start the SMF service
#                                site/homicron-apply, and stream its log
#   bin/homicron ssh <name>      open a shell on the box as $HOMICRON_USER
#
# The steps run on the box under svc:/site/homicron-apply, so one apply runs
# at a time, a lost ssh or a Ctrl-C leaves it running, and a second apply
# attaches to it. A reboot a step asks for is done by the box; the runner
# waits and reconnects.
#
# <name> selects hosts/<name>.env. A variable already set in the environment
# wins over the file, so private addresses never need to be committed.
#
# HOMICRON_KEYS names the public keys to install, as a URL or a file path.
# Unset, the runner ships every ~/.ssh/*.pub on this machine.
#
set -o errexit -o pipefail -o nounset

root=$(cd "$(dirname "$0")/.." && pwd)
remote_dir=/opt/homicron
remote_log_dir=/var/log/homicron
remote_log=$remote_log_dir/apply.log
service=site/homicron-apply
# Every ssh and the rsync transport use these. Keepalives: a NAT or port
# forward (qemu user networking, some firewalls) never closes the connection
# when the box goes down, and a plain ssh would hang forever. The connect
# timeout keeps the reboot poll moving while the box is down.
ssh_opts=()

poll=${HOMICRON_POLL_SECONDS:-5}
reboot_timeout=${HOMICRON_REBOOT_TIMEOUT:-600}
# How long watch-apply.sh waits on the box for the service to settle.
apply_timeout=${HOMICRON_APPLY_TIMEOUT:-7200}

# The variables a hosts file may set and host.env always carries. load_host
# refuses any other key, so a typo cannot fall back to a default in silence.
host_vars=(HOMICRON_USER HOMICRON_UID HOMICRON_ADDR HOMICRON_PORT SWAP_SIZE DUMP_SIZE
           FALCON_DATASET VOXEL_REF VOXEL_SLEDS VOXEL_SLED_MEMORY_GB)
# Accepted in the hosts file and the environment like the others, but used
# by the runner only and never shipped in host.env.
runner_vars=(HOMICRON_KEYS)

usage() {
  printf 'usage: homicron apply <name> | homicron ssh <name>\n' >&2
  exit 2
}

die() {
  printf 'homicron: %s\n' "$1" >&2
  exit "${2:-1}"
}

# A value the box can source as shell without surprise: letters, digits,
# and the punctuation that logins, sizes, dataset names, git refs, hosts
# and addresses need. Everything else (whitespace, quotes, `;`, `|`, `$`,
# `~`, ...) is refused, so the line is read literally on both sides.
valid_value() {
  local re='^[A-Za-z0-9._/:@%+,-]*$'
  [[ $1 =~ $re ]]
}

known_var() {
  local v
  for v in "${host_vars[@]}" "${runner_vars[@]}"; do
    [[ $v == "$1" ]] && return 0
  done
  return 1
}

# A key line has a key type field followed by a base64 field, after any
# options such as from="...". sshd accepts sk- types and ecdsa- types too.
type_re='^(sk-)?(ssh|ecdsa)-[A-Za-z0-9.@-]+$'
# Every OpenSSH blob starts with AAAA: the base64 of the length prefix.
blob_re='^AAAA[A-Za-z0-9+/]+=*$'

is_key_line() {
  local -a f
  local i
  read -r -a f <<< "$1"
  for (( i = 0; i + 1 < ${#f[@]}; i++ )); do
    if [[ ${f[i]} =~ $type_re && ${f[i+1]} =~ $blob_re ]]; then
      return 0
    fi
  done
  return 1
}

# Every line must be blank, a comment, or a key, and at least one must be a
# key. Step 10 overwrites root's authorized_keys with this file, so a wrong
# URL that returns an HTML page would lock the box: each bad line is named
# and the file is refused.
key_count=0
check_keys_file() {
  local file="$1" line n=0 keys=0 bad=0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$(( n + 1 ))
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    if is_key_line "$line"; then
      keys=$(( keys + 1 ))
    else
      printf 'homicron: keys: line %d is not a public key\n' "$n" >&2
      bad=1
    fi
  done < "$file"
  if (( bad == 0 && keys == 0 )); then
    printf '%s: keys: no key line (every line is blank or a comment)\n' "homicron" >&2
  fi
  key_count=$keys
  (( bad == 0 && keys > 0 ))
}

# Write the keys to ship to OUT: HOMICRON_KEYS as a URL or a file path, or
# every ~/.ssh/*.pub on this machine. Certificates (*-cert.pub) are not
# keys sshd accepts in authorized_keys and are skipped.
collect_keys() {
  local out="$1" src=${HOMICRON_KEYS-} f label
  label=${src:-'~/.ssh/*.pub'}
  if [[ $src =~ ^https?:// ]]; then
    curl -fsSL "$src" > "$out" || die "cannot fetch keys from $src" 2
  elif [[ -n $src ]]; then
    [[ -f $src && -r $src ]] || die "HOMICRON_KEYS: $src is not a readable file" 2
    cat "$src" > "$out"
  else
    : > "$out"
    for f in "$HOME"/.ssh/*.pub; do
      [[ -f $f && $f != *-cert.pub ]] || continue
      # awk 1 ends every line with a newline, so a file without one cannot
      # fuse with the next.
      awk 1 "$f" >> "$out"
    done
    if ! grep -Eq '^[[:space:]]*[^#[:space:]]' "$out"; then
      die 'no public key in ~/.ssh/*.pub; set HOMICRON_KEYS to a URL or a file path' 2
    fi
  fi
  check_keys_file "$out" || die "refusing to ship a keys file that is not a usable authorized_keys file" 2
  # The shipped file replaces every key on the box, so say what won.
  printf 'shipping %d key%s from %s\n' "$key_count" "$([[ $key_count == 1 ]] || printf s)" "$label"
}

# The reboot wait reads the clock here and waits with sleep, so a test can
# fake both commands and never wait.
now() {
  date +%s
}

#
# Load hosts/<name>.env. Environment values take precedence over the file.
# Each line is KEY=VALUE, read literally; anything else is a configuration
# error, reported with its line number.
#
load_host() {
  local name="$1" file key value n=0
  file="$root/hosts/$name.env"
  [[ -f $file ]] || die "no host file $file" 2
  while IFS= read -r line || [[ -n $line ]]; do
    n=$(( n + 1 ))
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    if ! [[ $line =~ ^[A-Z][A-Z0-9_]*= ]] || ! valid_value "${line#*=}"; then
      die "hosts/$name.env line $n: expected KEY=VALUE with no spaces, quotes, or comments" 2
    fi
    key=${line%%=*}
    value=${line#*=}
    known_var "$key" || die "hosts/$name.env line $n: unknown variable $key (see hosts/README.md)" 2
    if [[ -z ${!key+set} ]]; then
      export "$key=$value"
    fi
  done < "$file"

  # The login and uid default to this workstation's, so files that move
  # between the two machines keep a readable owner. Root is never a valid
  # answer: the runner logs in as root and step 10 would run useradd -u 0.
  export HOMICRON_USER=${HOMICRON_USER:-$(id -un)}
  export HOMICRON_UID=${HOMICRON_UID:-$(id -u)}
  if [[ $HOMICRON_USER == root ]]; then
    die "HOMICRON_USER=root: the runner logs in as root and will not create root; set HOMICRON_USER and HOMICRON_UID" 2
  fi
  # A positive integer with no leading zero: 0, 00, and 000 all mean root to
  # useradd, and a non-number would fail on the box instead of here.
  if ! [[ $HOMICRON_UID =~ ^[1-9][0-9]*$ ]]; then
    die "HOMICRON_UID=$HOMICRON_UID: must be a positive integer, and 0 is root, which the runner will not create" 2
  fi

  export HOMICRON_ADDR=${HOMICRON_ADDR:-$name.local}
  export HOMICRON_PORT=${HOMICRON_PORT:-22}
  export SWAP_SIZE=${SWAP_SIZE:-16G}
  export DUMP_SIZE=${DUMP_SIZE:-16G}
  export FALCON_DATASET=${FALCON_DATASET-}
  export VOXEL_REF=${VOXEL_REF:-main}
  export VOXEL_SLEDS=${VOXEL_SLEDS:-4}
  export VOXEL_SLED_MEMORY_GB=${VOXEL_SLED_MEMORY_GB:-8}

  ssh_opts=(-p "$HOMICRON_PORT" -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=3)
}

# ssh exits 255 for every transport failure: a box that is down, and also a
# host key that no longer matches known_hosts, which a reinstall causes.
unreachable() {
  die "cannot reach $HOMICRON_ADDR: ssh exited 255 (the box is down, or its host key changed after a reinstall; try ssh root@$HOMICRON_ADDR by hand)" 1
}

remote() {
  # shellcheck disable=SC2029  # callers pass a command string meant to expand on the box
  ssh "${ssh_opts[@]}" "root@$HOMICRON_ADDR" "$@"
}

# rsync SRC to a path under /opt/homicron on the box. rsync is the first
# remote contact, so an unreachable box surfaces here as 255.
sync_to_box() {
  local src="$1" dest="$2" status=0
  rsync -az "${@:3}" -e "ssh ${ssh_opts[*]}" "$src" "root@$HOMICRON_ADDR:$remote_dir/$dest" || status=$?
  (( status == 0 )) && return 0
  (( status == 255 )) && unreachable
  die "rsync failed with status $status" 1
}

# The box gets a fully resolved host.env: file values, environment
# overrides, and defaults, so steps never see an unset variable.
write_resolved_env() {
  local out="$1" var
  : > "$out"
  for var in "${host_vars[@]}"; do
    valid_value "${!var}" || die "$var has characters the runner cannot ship" 2
    printf '%s=%s\n' "$var" "${!var}" >> "$out"
  done
}

# The kernel boot time, so a reboot can be told from an ssh that never
# connected: on illumos a successful `reboot` kills sshd before the system
# goes down, and that ends the session with 255 just like a failed connect.
boot_time() {
  remote 'kstat -p unix:0:system_misc:boot_time' 2>/dev/null | awk '{ print $2 }'
}

# "<state> <stime>" of the service, "missing -" when it is not imported yet,
# "unreachable -" when ssh failed (this runs in a subshell, so the caller
# ends the apply; a die here would only end the subshell).
service_state() {
  local out status=0
  out=$(remote "svcs -H -o state,stime $service 2>/dev/null") || status=$?
  if (( status == 255 )); then
    printf 'unreachable -\n'
  elif (( status == 0 )) && [[ -n $out ]]; then
    printf '%s\n' "$out"
  else
    printf 'missing -\n'
  fi
}

# Lines in apply.log now, so only the new run is streamed.
log_lines() {
  local n
  n=$(remote "wc -l < $remote_log 2>/dev/null || echo 0") || n=0
  n=${n// /}
  printf '%s\n' "${n:-0}"
}

# The line before the current run's header, so an attach starts at the header.
run_header_offset() {
  local n
  n=$(remote "grep -n '^=== run' $remote_log 2>/dev/null | tail -1 | cut -d: -f1") || n=
  n=${n// /}
  printf '%s\n' "$(( ${n:-1} - 1 ))"
}

# The box announced a reboot and the ssh dropped. Wait until it is back with
# a new boot time, or, when the boot time could not be read before, until
# ssh works again.
wait_for_reboot() {
  local before="$1" after deadline
  printf 'waiting for the box to come back\n'
  deadline=$(( $(now) + reboot_timeout ))
  while true; do
    if (( $(now) >= deadline )); then
      die "cannot reach $HOMICRON_ADDR after reboot (${reboot_timeout}s)"
    fi
    sleep "$poll"
    if [[ -z $before ]]; then
      remote true >/dev/null 2>&1 && return 0
    else
      after=$(boot_time) || continue
      [[ -n $after && $after != "$before" ]] && return 0
    fi
  done
}

# Stream apply.log from line $seen through watch-apply.sh, counting the
# lines shown and keeping the last one. Returns the watcher's status (255
# when ssh dropped), carried on a sentinel line so it survives the pipe.
seen=0
last_line=
watch() {
  local line status=0
  while IFS= read -r line; do
    if [[ $line == "__watch_exit "* ]]; then
      status=${line#__watch_exit }
      continue
    fi
    printf '%s\n' "$line"
    seen=$(( seen + 1 ))
    last_line=$line
  done < <(remote "$remote_dir/watch-apply.sh $seen $apply_timeout" || status=$?; printf '__watch_exit %s\n' "$status")
  return "$status"
}

apply() {
  local name="$1" state stime tmp before out status
  load_host "$name"
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064  # expand now: the local is gone when the trap runs
  trap "rm -rf '$tmp'" EXIT
  write_resolved_env "$tmp/host.env"
  collect_keys "$tmp/authorized_keys"

  read -r state stime <<< "$(service_state)"
  [[ $state == unreachable ]] && unreachable
  if [[ $state == offline* ]]; then
    printf 'an apply is already running on the box since %s; attaching, nothing was shipped\n' "$stime"
    seen=$(run_header_offset)
  else
    seen=$(log_lines)
    printf 'syncing host/ to root@%s:%s\n' "$HOMICRON_ADDR" "$remote_dir"
    sync_to_box "$root/host/" "" --delete
    sync_to_box "$tmp/host.env" host.env
    sync_to_box "$tmp/authorized_keys" authorized_keys
    status=0
    out=$(remote "$remote_dir/start-apply.sh") || status=$?
    (( status == 255 )) && unreachable
    [[ -n $out ]] && printf '%s\n' "$out"
    (( status != 0 )) && die "start-apply.sh exited $status" 1
    [[ $out == "an apply is already running on the box" ]] && seen=$(run_header_offset)
  fi

  before=$(boot_time) || before=
  while true; do
    status=0
    watch || status=$?
    case $status in
      0) exit 0 ;;
      1)
        if [[ $last_line =~ ^step\ (.+)\ failed\ with\ status\ ([0-9]+) ]]; then
          die "step ${BASH_REMATCH[1]} failed with status ${BASH_REMATCH[2]}" "${BASH_REMATCH[2]}"
        fi
        die "a step failed; the log is $remote_log on the box" 1
        ;;
      255)
        [[ $last_line == "rebooting for "* ]] || unreachable
        wait_for_reboot "$before"
        before=$(boot_time) || before=
        ;;
      4) die "apply still running after ${apply_timeout}s; rejoin with homicron apply $name" 1 ;;
      *) die "watch-apply.sh exited $status; the log is $remote_log on the box" 1 ;;
    esac
  done
}

(( $# == 2 )) || usage
case "$1" in
  apply)
    apply "$2"
    ;;
  ssh)
    load_host "$2"
    # No keepalives here: an interactive session may be running a 45-minute
    # image build, and a short network drop must not end it.
    exec ssh -p "$HOMICRON_PORT" "$HOMICRON_USER@$HOMICRON_ADDR"
    ;;
  *)
    usage
    ;;
esac
