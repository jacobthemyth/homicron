#!/bin/bash
#
# homicron first-boot service. Runs once on the first boot after
# install-helios: brings up DHCP on every physical link, enables sshd and
# mDNS, reports the addresses on the console, then disables itself.
#
# This method must always exit 0. A failing method would put the service in
# maintenance and hide the console login.
#
set -o nounset

conf=${HOMICRON_CONF:-/etc/homicron.conf}
msglog=${HOMICRON_MSGLOG:-/dev/msglog}
dhcp_wait=${HOMICRON_DHCP_WAIT:-60}
resolv_conf=${HOMICRON_RESOLV_CONF:-/etc/resolv.conf}

HOSTNAME=unknown
if [[ -r $conf ]]; then
  # shellcheck disable=SC1090
  source "$conf"
fi

say() {
  printf 'homicron-firstboot: %s\n' "$*"
  printf 'homicron-firstboot: %s\n' "$*" >> "$msglog" 2>/dev/null
}

say "host $HOSTNAME: configuring network"

links=$(dladm show-phys -p -o link 2>/dev/null)
for link in $links; do
  if ipadm show-addr -p -o addrobj 2>/dev/null | grep -qx "$link/v4"; then
    say "$link already has a v4 address object"
    continue
  fi
  if ipadm create-addr -T dhcp "$link/v4"; then
    say "requested DHCP on $link"
  else
    say "ipadm create-addr failed on $link"
  fi
done

svcadm enable network/ssh || say "could not enable network/ssh"
svcadm enable network/dns/multicast || say "could not enable network/dns/multicast"

addrs=
for (( i = 0; i < dhcp_wait; i++ )); do
  addrs=$(ipadm show-addr -p -o addr 2>/dev/null | grep -v '^127\.' | grep -v ':' || true)
  if [[ -n $addrs ]]; then
    break
  fi
  sleep 1
done

#
# dhcpagent records the DNS servers from the lease but does not write
# /etc/resolv.conf (that is nwam's job, and Helios does not run nwam).
#
write_resolv_conf() {
  local link servers domain found=no
  for link in $links; do
    servers=$(dhcpinfo -i "$link" DNSserv 2>/dev/null || true)
    [[ -n $servers ]] || continue
    if [[ $found == no ]]; then
      : > "$resolv_conf"
      found=yes
      domain=$(dhcpinfo -i "$link" DNSdmain 2>/dev/null || true)
      [[ -n $domain ]] && printf 'domain %s\n' "$domain" >> "$resolv_conf"
    fi
    for s in $servers; do
      printf 'nameserver %s\n' "$s" >> "$resolv_conf"
    done
  done
  if [[ $found == yes ]]; then
    say "wrote $resolv_conf from the DHCP lease"
    svcadm refresh network/dns/client || say "could not refresh network/dns/client"
  else
    say "no DNS servers in the DHCP lease; $resolv_conf not written"
  fi
}

if [[ -n $addrs ]]; then
  if [[ ! -s $resolv_conf ]]; then
    write_resolv_conf
  fi
  say "host $HOSTNAME is reachable at:"
  for a in $addrs; do
    say "  $a"
  done
else
  say "no DHCP address after ${dhcp_wait}s; sshd is enabled, fix the network from the console"
fi

svcadm disable site/homicron-firstboot || say "could not disable site/homicron-firstboot"

exit 0
