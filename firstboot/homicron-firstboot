#!/bin/bash
#
# homicron first-boot service. Runs once on the first boot after
# install-helios: brings up DHCP on every physical link, enables sshd and
# mDNS, reports the addresses on the console, then disables itself. DNS
# comes from the dhcpagent event hook (firstboot/dhcp-eventhook), which the
# installer seeds to /etc/dhcp/eventhook.
#
# This method must always exit 0. A failing method would put the service in
# maintenance and hide the console login.
#
set -o nounset

# The SMF method PATH is /usr/sbin:/usr/bin; dhcpinfo lives in /sbin.
PATH="$PATH:/sbin"

conf=${HOMICRON_CONF:-/etc/homicron.conf}
msglog=${HOMICRON_MSGLOG:-/dev/msglog}
dhcp_wait=${HOMICRON_DHCP_WAIT:-60}
eventhook=${HOMICRON_EVENTHOOK:-/etc/dhcp/eventhook}

HOSTNAME=unknown
if [[ -r $conf ]]; then
  # shellcheck disable=SC1090
  source "$conf"
fi

say() {
  printf 'homicron-firstboot: %s\n' "$*"
  printf 'homicron-firstboot: %s\n' "$*" >> "$msglog" 2>/dev/null
}

say "host $HOSTNAME: configuring network"

links=$(dladm show-phys -p -o link 2>/dev/null)
for link in $links; do
  if ipadm show-addr -p -o addrobj 2>/dev/null | grep -qx "$link/v4"; then
    say "$link already has a v4 address object"
    continue
  fi
  # -w 0: do not wait here at all; dhcpagent keeps trying in the background
  # and the poll below picks the address up. A port with no cable costs
  # nothing.
  if ipadm create-addr -T dhcp -w 0 "$link/v4"; then
    say "requested DHCP on $link"
  else
    say "ipadm create-addr failed on $link"
  fi
done

svcadm enable network/ssh || say "could not enable network/ssh"
svcadm enable network/dns/multicast || say "could not enable network/dns/multicast"

# Wait for a real IPv4 address. ipadm prints `?` for a DHCP address object
# that has no lease yet, so match a dotted address and skip loopback.
addrs=
for (( i = 0; i < dhcp_wait; i++ )); do
  addrs=$(ipadm show-addr -p -o addr 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | grep -v '^127\.')
  if [[ -n $addrs ]]; then
    break
  fi
  sleep 1
done

# Run the hook now for every link that already has a lease, so the common
# case does not wait for dhcpagent's callback. The hook ignores a link
# without DNS servers, and dhcpagent runs it again when a lease lands later.
for link in $links; do
  "$eventhook" "$link" BOUND || say "dhcp hook failed on $link"
done

if [[ -n $addrs ]]; then
  say "host $HOSTNAME is reachable at:"
  for a in $addrs; do
    say "  $a"
  done
else
  say "no DHCP address after ${dhcp_wait}s; sshd is enabled, and the lease brings the address and DNS when it arrives"
fi

svcadm disable site/homicron-firstboot || say "could not disable site/homicron-firstboot"

exit 0
